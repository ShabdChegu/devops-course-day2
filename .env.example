# Copy this to .env and change the password before `make up`:
#     cp .env.example .env
# .env is gitignored - it is YOUR machine's file. This template is what
# ships. A committed .env with real credentials in it is the exact
# incident the secret-scan hook (ch.7's CI gate) exists to stop.

POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=notes

# ch.8 - the deploy target (CONFIGURATION, not secrets: an IP is not a
# password, so it ships in .env, and the same vars drive the pipeline -
# jenkins/docker-compose.yml's environment: interpolates them, ch.7's
# secret hygiene preserved: only the SSH KEY is a secret, and it lives in
# Jenkins' server-ssh credential, NEVER here).
#
#   SERVER_HOST=127.0.0.1  -> the local dry-run: deploy.sh runs the app
#   server project on THIS machine (the whole chapter works with no VPS)
#   SERVER_HOST=<vps ip>   -> the same script over ssh; bootstrap.sh
#   (server/) converges the box first; your public key goes in its
#   authorized_keys (the one human step - the private half is the
#   server-ssh credential in Jenkins)
SERVER_HOST=127.0.0.1
# who runs deploy.sh on the box (a VPS-only concern; 127.0.0.1 ignores it)
SERVER_USER=aman
# the app's port ON THE BOX - deploy.sh's verification curl hits it
SERVER_PORT=8000
# only used by `make deploy` with no argument (a local dev image); the
# pipeline always passes this build's SHA tag instead
APP_IMAGE=notes-app:latest

# Copy this to .env and change the password before `make up`:
#     cp .env.example .env
# .env is gitignored - it is YOUR machine's file. This template is what
# ships. A committed .env with real credentials in it is the exact
# incident the secret-scan hook (ch.7's CI gate) exists to stop.

POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=notes

# ch.8 - the deploy target (CONFIGURATION, not secrets: an IP is not a
# password, so it ships in .env, and the same vars drive the pipeline -
# jenkins/docker-compose.yml's environment: interpolates them, ch.7's
# secret hygiene preserved: only the SSH KEY is a secret, and it lives in
# Jenkins' server-ssh credential, NEVER here).
#
#   SERVER_HOST=127.0.0.1  -> the local dry-run: deploy.sh runs the app
#   server project on THIS machine (the whole chapter works with no VPS)
#   SERVER_HOST=<vps ip>   -> the same script over ssh; bootstrap.sh
#   (server/) converges the box first; your public key goes in its
#   authorized_keys (the one human step - the private half is the
#   server-ssh credential in Jenkins)
SERVER_HOST=127.0.0.1
# who runs deploy.sh on the box (a VPS-only concern; 127.0.0.1 ignores it)
SERVER_USER=aman
# the app's port ON THE BOX - deploy.sh's verification curl hits it
SERVER_PORT=8000
# HUMAN deploy path only (`make deploy` / bare bash server/deploy.sh): the
# private key's PATH on YOUR machine (the key itself is a secret - a file on
# your disk, gitignored like ch.5; never its contents). The pipeline never
# reads this: its key is the server-ssh Jenkins credential. Leave empty to
# use OpenSSH's default keys (~/.ssh/id_ed25519 ...). A path is config,
# not a secret - that's why this ships here.
#SERVER_SSH_KEY=
# only used by `make deploy` with no argument (a local dev image); the
# pipeline always passes this build's SHA tag instead
APP_IMAGE=notes-app:latest

# ch.9/10 - the telemetry knobs (compose interpolates these; all have
# working defaults, so a bare .env still runs the app instrumented to
# console). Behavior from the environment - the ch.5 rule, applied to
# observability:
#   OTEL_ENABLED=true/false - run with the OpenTelemetry machinery at all
#   OTEL_EXPORTER=console - ch.9: spans print to the app's stdout (make logs)
#   OTEL_EXPORTER=otlp    - ch.10: traces + metrics + logs -> the SigNoz
#                           collector (gRPC, OTEL_OTLP_ENDPOINT below)
#   OTEL_SERVICE_NAME     - the "who am I" attribute; SigNoz groups every
#                           dashboard by it
OTEL_ENABLED=true
OTEL_EXPORTER=console
OTEL_SERVICE_NAME=notes-app
# ch.10: the OTLP destination. Inside the compose network "signoz" is the
# ingester's alias, so this works unchanged once you've started the
# signoz profile (make up-signoz). The ch.9 console exporter ignores it.
# THE ch.10 FLIP is one line in this file: OTEL_EXPORTER=otlp, then
# `make up` again (docs/10 step 3).
OTEL_OTLP_ENDPOINT=http://signoz:4317

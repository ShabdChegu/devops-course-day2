# Local .terraform directories
**/.terraform/*

# .tfstate and plan files
*.tfstate
*.tfstate.*
plan.json
*.tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Sensitive keys generated by terraform
*.pem
*.key

